    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.size
      value: 12
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[0].text
      value: Oh, uh, this is new.
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[1].text
      value: "I don't remember placing this here\u2014"
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[2].text
      value: Um, excuse me, Mr. Wall.
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[3].text
      value: You are blocking the way.
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[4].text
      value: '*gibberish*'
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[5].text
      value: Can you move out of the way so we can get through?
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[6].text
      value: '*angry gibberish*'
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[7].text
      value: "I'm not\u2014 no, I'm not going to beg for it\u2014"
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[8].text
      value: '*insistent gibberish*'
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[9].text
      value: '*sigh* Please??? Pretty please???'
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[10].text
      value: '*pleased gibberish*'
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[11].text
      value: Just... we don't talk about this. Ever.
      objectReference: {fileID: 0}
    - target: {fileID: 4918601087994725340, guid: 5c1ec8c2cff3d2f4ca51e6a2f9ca076d, type: 3}
      propertyPath: dialogueQueue.Array.data[12].text
      value: Just... we don't talk about this. Ever.
      objectReference: {fileID: 0}
