    - target: {fileID: 4369623599917639537, guid: e92c9ce989f189543bb4cd520029fafb, type: 3}
      propertyPath: dialogueQueue.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 4369623599917639537, guid: e92c9ce989f189543bb4cd520029fafb, type: 3}
      propertyPath: dialogueQueue.Array.data[0].text
      value: Hello.
      objectReference: {fileID: 0}
    - target: {fileID: 4369623599917639537, guid: e92c9ce989f189543bb4cd520029fafb, type: 3}
      propertyPath: dialogueQueue.Array.data[1].text
      value: Welcome to the Long-term Observation of Ongoing Plasticity (LOOP) program.
      objectReference: {fileID: 0}
    - target: {fileID: 4369623599917639537, guid: e92c9ce989f189543bb4cd520029fafb, type: 3}
      propertyPath: dialogueQueue.Array.data[2].text
      value: You've been selected from one of the many... *papers rustling*
      objectReference: {fileID: 0}
    - target: {fileID: 4369623599917639537, guid: e92c9ce989f189543bb4cd520029fafb, type: 3}
      propertyPath: dialogueQueue.Array.data[3].text
      value: ...THREE applicants to reach out to us.
      objectReference: {fileID: 0}
    - target: {fileID: 4369623599917639537, guid: e92c9ce989f189543bb4cd520029fafb, type: 3}
      propertyPath: dialogueQueue.Array.data[4].text
      value: ' Unfortunately, the other two had anatidaephobia,'
      objectReference: {fileID: 0}
    - target: {fileID: 4369623599917639537, guid: e92c9ce989f189543bb4cd520029fafb, type: 3}
      propertyPath: dialogueQueue.Array.data[5].text
      value: so you're the best we can do.
      objectReference: {fileID: 0}
    - target: {fileID: 4369623599917639537, guid: e92c9ce989f189543bb4cd520029fafb, type: 3}
      propertyPath: dialogueQueue.Array.data[6].text
      value: Our goal is to see how humans, or whatever you are, adapt to changes
        in their environment.
      objectReference: {fileID: 0}
    - target: {fileID: 4369623599917639537, guid: e92c9ce989f189543bb4cd520029fafb, type: 3}
      propertyPath: dialogueQueue.Array.data[7].text
      value: Please proceed to the door when you are ready.
      objectReference: {fileID: 0}
    - target: {fileID: 4369623599917639537, guid: e92c9ce989f189543bb4cd520029fafb, type: 3}
      propertyPath: dialogueQueue.Array.data[8].text
      value: (what even are you?)
      objectReference: {fileID: 0}
    - target: {fileID: 4369623599917639537, guid: e92c9ce989f189543bb4cd520029fafb, type: 3}
      propertyPath: dialogueQueue.Array.data[0].duration
